# Reference only — you do NOT create this file by hand.
#
# render-env.sh generates /opt/vera/app.env on the VM each deploy by reading the
# `vera-test-*` secrets from Secret Manager (mapping in secrets.map) and injects
# it into the containers via the compose env_file. This file just documents the
# shape of that rendered result so you know what the containers receive.
#
# Google ADC comes from the VM's attached service account (metadata server), so
# Vertex AI / Cloud KMS need no key file here — grant the roles to the VM's SA.

# Non-secret, written directly by render-env.sh. VERA_ENV must be one of
# local/dev/staging/prod (the Settings Literal has no `test`), so the GCP `test`
# environment runs as `dev`.
VERA_ENV=dev
VERA_LOG_LEVEL=INFO
VERA_EMAIL_FROM=...                  # Twilio-verified sender identity

# Rendered from Secret Manager (secret basename → env var; see secrets.map):
VERA_DATABASE_URL=...          # from vera-test-database-url
VERA_REDIS_URL=...             # from vera-test-redis-url
VERA_FRONTEND_BASE_URL=...     # from vera-test-frontend-base-url
LOCAL_KMS_MASTER_KEY=...       # from vera-test-local-kms-master-key
VERA_LIVEKIT_URL=...           # from vera-test-livekit-url (control-plane)
LIVEKIT_URL=...                # from vera-test-livekit-url (worker)
LIVEKIT_API_KEY=...            # from vera-test-livekit-api-key
LIVEKIT_API_SECRET=...         # from vera-test-livekit-api-secret
DEEPGRAM_API_KEY=...           # from vera-test-deepgram-api-key
CARTESIA_API_KEY=...           # from vera-test-cartesia-api-key
GOOGLE_API_KEY=...             # from vera-test-google-api-key
VERA_TWILIO_ACCOUNT_SID=...    # from vera-test-twilio-account-sid (selects Twilio Email)
TWILIO_AUTH_TOKEN=...          # from vera-test-twilio-auth-token
# Twilio SIP trunk secrets not mapped (LiveKit holds the trunk; containers don't read them).

# NOTE: the voice pipeline carries NO PHI tokenization yet (PassthroughPHIBoundary) —
# use SYNTHETIC / role-play data only on calls until the PHI codec is integrated.
