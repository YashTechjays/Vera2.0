flowchart LR
    caller["📞 Caller<br/>(speech)"]
    stt["🎙️ STT (Deepgram)<br/>raw transcript"]
    tokenize["🔒 codec.tokenize()<br/>RAW PHI → [[TYPE_N]] tokens<br/>detect · vault · leak-canary"]
    llm["🤖 LLM (Gemini)<br/>sees ONLY tokens<br/>never raw PHI"]
    reid["🔓 codec.reidentify()<br/>tokens → RAW<br/>spell-out for speech"]
    tts["🔊 TTS (Cartesia)<br/>speaks real values"]
    callerout["📞 Caller<br/>(hears speech)"]

    reidargs["🔓 codec.reidentify_args()<br/>tokens → exact RAW<br/>(no TTS format)"]
    payer["🏥 Payer API<br/>exact raw values"]

    vault["🗄️ Per-session Vault — encrypted raw ↔ token map<br/>deterministic · lossless &nbsp;+&nbsp; 📋 append-only audit log"]
    seed["🌱 seed_session()<br/>pre-load known patient PHI<br/>EHR aliases → types"]

    caller --> stt
    stt -->|raw text| tokenize
    tokenize -->|tokenized text| llm
    llm -->|reply w/ tokens| reid
    reid -->|spoken text| tts
    tts --> callerout

    llm -.->|tool-call args| reidargs
    reidargs -.-> payer

    tokenize <-->|get_or_create_token| vault
    reid <-->|resolve token| vault
    reidargs <-->|resolve token| vault
    seed -.->|pre-mint tokens| vault

    classDef raw fill:#ffe0e0,stroke:#cc0000,color:#000
    classDef safe fill:#e0ffe0,stroke:#008800,color:#000
    classDef codec fill:#e0e8ff,stroke:#0044cc,color:#000
    classDef vault fill:#fff4d0,stroke:#cc8800,color:#000

    class caller,callerout,stt,tts,payer raw
    class llm safe
    class tokenize,reid,reidargs codec
    class vault,seed vault
