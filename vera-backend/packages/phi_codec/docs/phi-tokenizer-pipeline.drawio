<mxfile host="app.diagrams.net" type="device">
  <diagram name="PHI Tokenizer in Cascading Voice Pipeline" id="phi-pipeline">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="PHI Tokenizer in a Cascading Voice Pipeline (STT → LLM → TTS)" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="880" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Top row: cascading pipeline ===== -->

        <!-- Caller -->
        <mxCell id="caller" value="📞 Caller&#10;(speech)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- STT -->
        <mxCell id="stt" value="🎙️ STT&#10;(Deepgram)&#10;&#10;raw transcript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="170" width="130" height="90" as="geometry" />
        </mxCell>

        <!-- tokenize -->
        <mxCell id="tokenize" value="🔒 codec.tokenize()&#10;&#10;RAW PHI → [[TYPE_N]] tokens&#10;detect · vault · leak-canary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#0044cc;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="165" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- LLM -->
        <mxCell id="llm" value="🤖 LLM (Gemini)&#10;&#10;sees ONLY tokens&#10;never raw PHI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0ffe0;strokeColor=#008800;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="170" width="150" height="90" as="geometry" />
        </mxCell>

        <!-- reidentify -->
        <mxCell id="reid" value="🔓 codec.reidentify()&#10;&#10;tokens → RAW&#10;spell-out format for speech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#0044cc;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="165" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- TTS -->
        <mxCell id="tts" value="🔊 TTS&#10;(Cartesia)&#10;&#10;speaks real values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1130" y="170" width="130" height="90" as="geometry" />
        </mxCell>

        <!-- Caller out -->
        <mxCell id="callerout" value="📞 Caller&#10;(hears speech)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="180" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Tool-call branch ===== -->
        <mxCell id="reidargs" value="🔓 codec.reidentify_args()&#10;tokens → exact RAW (no TTS format)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#0044cc;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="350" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="payer" value="🏥 Payer API&#10;exact raw values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="350" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Vault ===== -->
        <mxCell id="vault" value="🗄️ Per-session Vault  (encrypted raw ↔ token map · deterministic · lossless)  +  📋 append-only audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d0;strokeColor=#cc8800;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="500" width="650" height="70" as="geometry" />
        </mxCell>

        <!-- seed -->
        <mxCell id="seed" value="🌱 seed_session()&#10;pre-load known patient PHI&#10;(EHR field aliases → types)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d0;strokeColor=#cc8800;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="500" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Pipeline edges ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="caller" target="stt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="raw text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="stt" target="tokenize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="tokenized text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="tokenize" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="reply w/ tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="llm" target="reid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="spoken text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="reid" target="tts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="tts" target="callerout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tool-call edges -->
        <mxCell id="e7" value="tool-call args (tokens)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="llm" target="reidargs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="reidargs" target="payer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vault edges -->
        <mxCell id="v1" value="get_or_create_token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;startArrow=open;html=1;strokeColor=#cc8800;fontSize=10;" edge="1" parent="1" source="tokenize" target="vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="resolve token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;startArrow=open;html=1;strokeColor=#cc8800;fontSize=10;" edge="1" parent="1" source="reid" target="vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="resolve token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;startArrow=open;html=1;strokeColor=#cc8800;fontSize=10;" edge="1" parent="1" source="reidargs" target="vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="pre-mint tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;strokeColor=#cc8800;fontSize=10;dashed=1;" edge="1" parent="1" source="seed" target="vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="🔴 raw PHI zone   🟢 token-only LLM   🔵 codec (tokenize / reidentify)   🟡 vault &amp; seeding&#10;Boundary rule: real PHI exists only left-of-LLM (in vault); the LLM &amp; its logs see tokens only." style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="610" width="650" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
