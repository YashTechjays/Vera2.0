# Copy to .env and fill in:  cp env.example .env
# .env is loaded automatically by the test suite (conftest) and the UI (app).
# .env is git-ignored — never commit real keys.

# Public Gemini Developer API key (https://aistudio.google.com/apikey).
# Enables tests/test_llm_roundtrip.py (the live token-survival check).
GOOGLE_API_KEY=

# Optional: override the Gemini model used by the round-trip test.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: enable the GLiNER ML name/location backend in the UI (1 = on).
# Off by default for fast startup; structured-ID recall is unaffected.
# PHI_GLINER=0
