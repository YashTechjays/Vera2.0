# Copy to .env for local dev. Every VERA_* var maps to vera_core.config.Settings.

VERA_ENV=local
VERA_LOG_LEVEL=INFO

# docker-compose services
VERA_DATABASE_URL=postgresql+asyncpg://vera:vera@localhost:5432/vera
VERA_REDIS_URL=redis://localhost:6379/0

# MFA envelope encryption (KMS).
# Local/dev uses LocalDevKMS, which wraps the per-user DEK with AES-256-GCM under a
# 32-byte master key. Unlike VERA_* vars (loaded by pydantic Settings), this one is
# read straight from the process environment via os.environ — the justfile's
# `set dotenv-load` makes it reach `just api`/`worker`/`seed` from this .env. If you
# run uvicorn WITHOUT just, export it in your shell instead.
# Keep it stable: a new key cannot decrypt already-stored TOTP seeds, which locks out
# enrolled users until their MFA is reset. Generate once:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
LOCAL_KMS_MASTER_KEY=
# Production (GKE): leave LOCAL_KMS_MASTER_KEY unset and use Cloud KMS instead
# (GCPCloudKMS via Workload Identity). VERA_KMS_KEY_NAME is a normal .env/Settings var:
# VERA_KMS_KEY_NAME=projects/<project>/locations/<loc>/keyRings/<ring>/cryptoKeys/<key>

# Observability — self-hosted Langfuse (docker compose up -d langfuse-web ...)
# Keys below match the docker-compose LANGFUSE_INIT_* deterministic values — no manual setup needed.
# VERA_LANGFUSE_HOST=http://localhost:4000
# VERA_LANGFUSE_PUBLIC_KEY=pk-lf-vera-local-public
# VERA_LANGFUSE_SECRET_KEY=sk-lf-vera-local-secret

# Voice pipeline — LiveKit (local: `docker compose up -d livekit`, the --dev server)
# Control plane reads VERA_LIVEKIT_URL (a VERA_* Settings var) to mint join tokens +
# dispatch the worker; when unset, the LiveKit gateway is disabled (call endpoints
# raise until configured). The worker reads LIVEKIT_* straight from the environment.
# VERA_LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Outbound SIP trunk for Voice Lab / telephony. Unset → outbound calls are disabled
# (fail closed); the LiveKit SIP service + trunk are provisioned out of band.
# VERA_LIVEKIT_SIP_TRUNK_ID=ST_xxxxxxxxxxxx

# Voice pipeline — vendor API keys for the cascade (agent worker; read from the
# environment by the livekit plugins). Required to run a real call; the worker
# fails to start the STT/LLM/TTS pipeline without them.
#   Deepgram (STT), Cartesia (TTS), Vertex AI / Gemini (LLM).
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# GOOGLE_API_KEY=
# Gemini via Vertex/service account instead of an API key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# NOTE: the voice pipeline carries NO PHI tokenization yet (PassthroughPHIBoundary) —
# use SYNTHETIC / role-play data only on calls until the PHI codec is integrated.
