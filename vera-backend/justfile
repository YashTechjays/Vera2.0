# Vera backend — task runner. `just` lists recipes, `just check` runs the full gate.

# Load .env into the recipe environment (no-op if absent). Lets non-VERA_ process
# vars like LOCAL_KMS_MASTER_KEY — read via os.environ, not pydantic Settings —
# reach `just api`/`worker`/`seed` from .env instead of a manual shell export.
set dotenv-load := true

default:
    @just --list

# Install/refresh the workspace venv from the lockfile
bootstrap:
    uv sync --all-packages

# Format code in place
fmt:
    uv run ruff format .
    uv run ruff check --fix .

# Lint (no changes)
lint:
    uv run ruff format --check .
    uv run ruff check .

typecheck:
    uv run mypy

test *args:
    uv run pytest {{args}}

# Full local gate — what CI runs
check: lint typecheck test

# Core local infra (Postgres + Redis + sendria + livekit). The Langfuse stack is
# behind the "langfuse" compose profile, so it is NOT started here.
up:
    docker compose up -d --wait

down:
    docker compose down

# Langfuse v3 observability stack — opt-in, heavy. Gated behind the "langfuse"
# compose profile so it never rides along with `just up`. Web UI: http://localhost:4000
langfuse-up:
    docker compose --profile langfuse up -d

# `down` needs the profile too, else the langfuse containers are treated as orphans.
langfuse-down:
    docker compose --profile langfuse down

# Database
migrate:
    uv run alembic upgrade head

makemigration message:
    uv run alembic revision --autogenerate -m "{{message}}"

# Join divergent migration heads into one merge revision (never renumber by hand).
# See the migrations bullet in CLAUDE.md for why concurrent branches become heads.
merge-heads message="merge heads":
    uv run alembic merge heads -m "{{message}}"

# Recompile data/form_schemas/*.json from the vera_core.forms.catalog author sources.
# The freshness test in tests/unit/forms/test_schema_dsl.py fails when artifacts drift.
compile-schemas:
    uv run python scripts/compile_schemas.py

# Seed the shared sample admin (admin@veratechsolutions.example / dev-password-change-me)
seed:
    uv run python scripts/seed.py

# Seed your own admin login into the sample tenant: just seed-user you@x.com secret
seed-user email password:
    SEED_ADMIN_EMAIL="{{email}}" SEED_ADMIN_PASSWORD="{{password}}" uv run python scripts/seed.py

# Seed ONLY the baseline form schemas (IBV Form Standard DSL)
seed-schemas:
    uv run python scripts/seed.py --schemas

# Seed/replace one synthetic infertility patient form for local dev/demo review.
# status: ready_for_processing (curated demo fill, default) | exception_review
# (full a-to-z fill + a few disputed fields so the review UI has something to show).
test_seed_patient_data status="ready_for_processing":
    uv run python scripts/seed_patient_data.py --status {{status}}

# Probe the real intake endpoint (POST /api/v1/patient-forms) against a running
# `just api`, with payloads derived live from ../appscript.js's DATA_MAPPING —
# catches drift between the Sheet's field set and the live schema. Requires
# baseline schemas seeded (`just seed`/`just seed-schemas`) and `just api` running.
# scenario: all (default) | full | system_only | drop_system_field
intake-scenarios scenario="all":
    uv run python scripts/intake_scenarios.py --scenario {{scenario}}

# Seed ONLY the baseline prompts (bind to each schema's published version)
seed-prompts:
    uv run python scripts/seed.py --prompts

# Anchor audit_log chain heads to the WORM bucket (GKE CronJob entrypoint)
anchor-audit:
    uv run python scripts/audit_anchor.py

# Bootstrap platform operator #1 (SUPER_ADMIN, password+MFA): just bootstrap-platform you@x.com secret
bootstrap-platform email password:
    BOOTSTRAP_ADMIN_EMAIL="{{email}}" BOOTSTRAP_ADMIN_PASSWORD="{{password}}" uv run python scripts/bootstrap_platform_admin.py

# Run apps
api:
    uv run uvicorn control_plane.main:app --reload --port 8000

worker:
    uv run python -m agent_worker.main dev

# Drive the cascade from your terminal mic/speaker (no server/control-plane/DB; needs vendor keys + Vertex ADC + VERA_ENV=local)
worker-console:
    uv run python -m agent_worker.main console

# Print a QR code from an otpauth:// URI for local MFA testing (no network, secret stays local)
mfa-qr uri:
    uv run python scripts/mfa_qr.py '{{uri}}'
