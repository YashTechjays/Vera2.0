{
  "dsl_version": "2.1",
  "name": "Disease-Only Insurance Verification",
  "insurance_type": "disease_only",
  "description": "Dummy disease-only (critical illness) benefits verification form. Small but construct-complete: exercises every DSL feature the dynamic renderer supports.",
  "system_fields": {
    "chart_number": "sections.patient_information.chart_number",
    "patient_name": "sections.patient_information.patient_name",
    "patient_dob": "sections.patient_information.patient_dob",
    "patient_gender": "sections.patient_information.patient_gender",
    "member_id": "sections.policy_details.policy_number",
    "appointment_date": "sections.appointment_information.appointment_date",
    "appointment_type": "sections.appointment_information.appointment_type",
    "insurance_provider_name": "sections.insurance_reference_information.insurance_provider_name",
    "insurance_provider_phone_number": "sections.insurance_reference_information.insurance_phone_number",
    "verified_by": "sections.verification_information.verified_by",
    "callback_number": "sections.verification_information.callback_number",
    "form_completed_at": "sections.verification_information.verified_at"
  },
  "promoted_fields": {
    "patient_name": "sections.patient_information.patient_name",
    "patient_dob": "sections.patient_information.patient_dob",
    "chart_number": "sections.patient_information.chart_number",
    "appointment_date": "sections.appointment_information.appointment_date",
    "appointment_type": "sections.appointment_information.appointment_type",
    "member_id": "sections.policy_details.policy_number",
    "insurance_provider": "sections.insurance_reference_information.insurance_provider_name",
    "insurance_provider_phone_number": "sections.insurance_reference_information.insurance_phone_number"
  },
  "rep_call_reference_number_field": "sections.representative_details.call_reference_number",
  "shared_conditions": {
    "disease_covered": {
      "field": "sections.coverage_summary.disease_coverage_active",
      "op": "eq",
      "value": "Yes"
    }
  },
  "sections": {
    "patient_information": {
      "title": "Patient Information",
      "role": "context",
      "description": "Patient identity supplied at intake; background for the agent.",
      "fields": {
        "chart_number": {
          "type": "text",
          "title": "Chart Number",
          "role": "input",
          "default": "N/A",
          "description": "Clinic-internal chart number. Display only; never part of the call."
        },
        "patient_name": {
          "type": "text",
          "title": "Patient Name",
          "role": "context",
          "required": true
        },
        "patient_dob": {
          "type": "date",
          "title": "Patient Date of Birth",
          "role": "context",
          "required": true,
          "validation": {
            "date_format": "M/D/YYYY"
          }
        },
        "patient_gender": {
          "type": "enum",
          "title": "Patient Gender",
          "role": "context",
          "required": true,
          "values": [
            "Female",
            "Male",
            "Other"
          ],
          "default": "N/A"
        }
      }
    },
    "appointment_information": {
      "title": "Appointment Information",
      "role": "context",
      "description": "Upcoming appointment details supplied at intake; background for the agent.",
      "fields": {
        "appointment_type": {
          "type": "enum",
          "title": "Appointment Type",
          "role": "context",
          "required": true,
          "values": [
            "New Patient",
            "Reverification",
            "Follow Up Visit",
            "N/A"
          ],
          "default": "N/A"
        },
        "appointment_date": {
          "type": "date",
          "title": "Appointment Date",
          "role": "context",
          "required": true,
          "validation": {
            "date_format": "M/D/YYYY"
          }
        }
      }
    },
    "verification_information": {
      "title": "Verification Information",
      "role": "context",
      "description": "Who is running this verification and how the clinic can be called back.",
      "fields": {
        "verified_by": {
          "type": "text",
          "title": "Verified By",
          "role": "context",
          "description": "Human supervisor named in the call introduction."
        },
        "verified_at": {
          "type": "date",
          "title": "Verified At",
          "role": "input",
          "validation": {
            "date_format": "M/D/YYYY"
          }
        },
        "callback_number": {
          "type": "phone",
          "title": "Callback Number",
          "role": "context",
          "default": "N/A",
          "description": "The callback phone number of your supervisor."
        }
      }
    },
    "policy_details": {
      "title": "Policy Details",
      "fields": {
        "policy_number": {
          "type": "text",
          "title": "Policy / Member ID",
          "role": "confirm",
          "required": true,
          "prompt": {
            "ask": "Can I get the member ID for this policy?",
            "confirm": "I have the member ID as {{value}} — can you confirm that is correct?"
          }
        },
        "plan_name": {
          "type": "text",
          "title": "Plan Name",
          "role": "ask",
          "required": true,
          "special_values": [
            "Critical Illness Basic",
            "Critical Illness Plus",
            "Disease Shield Complete"
          ],
          "prompt": {
            "ask": "What is the name of this disease-only plan?"
          }
        },
        "plan_type": {
          "type": "enum",
          "title": "Plan Type",
          "role": "ask",
          "required": true,
          "values": [
            "Individual",
            "Group"
          ],
          "special_values": [
            "Association"
          ],
          "prompt": {
            "ask": "Is this an individual or a group disease-only policy?"
          }
        },
        "effective_date": {
          "type": "date",
          "title": "Effective Date",
          "role": "ask",
          "required": true,
          "validation": {
            "date_format": "M/D/YYYY"
          },
          "prompt": {
            "ask": "What is the effective date for this coverage?"
          }
        },
        "group_number": {
          "type": "text",
          "title": "Group Number",
          "role": "ask",
          "required": {
            "when": {
              "field": "sections.policy_details.plan_type",
              "op": "eq",
              "value": "Group"
            }
          },
          "applicable_when": {
            "field": "sections.policy_details.plan_type",
            "op": "eq",
            "value": "Group"
          },
          "prompt": {
            "ask": "What is the group number for this policy?"
          }
        }
      }
    },
    "coverage_summary": {
      "title": "Coverage Summary",
      "fields": {
        "disease_coverage_active": {
          "type": "enum",
          "title": "Disease Coverage Active",
          "role": "ask",
          "required": true,
          "values": [
            "Yes",
            "No"
          ],
          "prompt": {
            "ask": "Is disease-specific coverage active on this policy?"
          }
        },
        "benefit_year_type": {
          "type": "enum",
          "title": "Benefit Year Type",
          "role": "ask",
          "required": true,
          "values": [
            "Calendar Year",
            "Plan Year"
          ],
          "default": "Calendar Year",
          "prompt": {
            "ask": "Does the benefit year run on a Calendar Year or a Plan Year?"
          }
        },
        "renewal_date": {
          "type": "date",
          "title": "Renewal Date",
          "role": "ask",
          "required": true,
          "validation": {
            "date_format": "M/D/YYYY"
          },
          "inapplicable_value": "N/A",
          "applicable_when": {
            "field": "sections.coverage_summary.benefit_year_type",
            "op": "eq",
            "value": "Plan Year"
          },
          "prompt": {
            "ask": "What is the renewal date for the plan year?"
          }
        },
        "annual_benefit_maximum": {
          "type": "currency",
          "title": "Annual Benefit Maximum",
          "role": "ask",
          "required": true,
          "special_values": [
            "No Limit"
          ],
          "validation": {
            "range": {
              "min": 0,
              "max": 1000000
            }
          },
          "prompt": {
            "ask": "What is the annual benefit maximum for disease coverage?"
          }
        },
        "policy_state": {
          "type": "text",
          "title": "Policy State",
          "role": "ask",
          "required": true,
          "validation": {
            "pattern": "^[A-Z]{2}$"
          },
          "prompt": {
            "ask": "What is the two-letter policy state, for example T X for Texas?"
          },
          "description": "Two-letter state code whose law governs the policy."
        },
        "state_mandate": {
          "type": "enum",
          "title": "State Disease Coverage Mandate",
          "role": "ask",
          "required": true,
          "values": [
            "Yes",
            "No"
          ],
          "prompt": {
            "ask": "Is there a state mandate for disease-specific coverage on this policy?"
          }
        }
      }
    },
    "covered_diseases": {
      "title": "Covered Diseases",
      "applicable_when": {
        "ref": "disease_covered"
      },
      "prompt": {
        "intro": "Now I'd like to go through the covered diseases one at a time."
      },
      "ui": {
        "layout": "table"
      },
