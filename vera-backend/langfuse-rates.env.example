# Langfuse model price rates — `source` this, then run `just langfuse-seed-prices`.
#
#   cp langfuse-rates.env.example langfuse-rates.env
#   # edit in your CONTRACTED rates
#   source langfuse-rates.env && just langfuse-seed-prices
#
# `langfuse-rates.env` is gitignored. These are not secrets — they are contract
# values — but they must never be hardcoded in Vera: the app holds no prices, and
# a second copy inside the repo is a copy that drifts.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE VALUES BELOW ARE PUBLIC LIST PRICES, NOT YOUR CONTRACTED RATES.
# They are a starting point so the seeder runs; replace what your contracts say.
# Provenance is marked per line:
#   [published]  from the vendor's public price list
#   [langfuse]   from Langfuse's own built-in model table on this instance
#   [inferred]   derived, NOT published — verify before trusting a cost figure
# ─────────────────────────────────────────────────────────────────────────────
#
# UNITS — the single easiest thing to get wrong:
#   * audio is priced PER MILLISECOND, because Langfuse stores usage as integers
#     and Vera reports whole ms. Vendors publish PER MINUTE, so divide by 60000.
#     Entering the per-minute figure is 60,000x too high and still renders a
#     plausible dollar amount.
#   * LLM is priced PER TOKEN. Vendors publish per MILLION tokens, so divide by 1e6.
#
# The seeder refuses to write anything if any rate is missing, zero, negative or
# non-finite — a $0.00 entry is indistinguishable from broken instrumentation.

# ── Deepgram STT — $ per millisecond of audio ────────────────────────────────
# Flux English streaming, $0.0065/min ÷ 60000                       [published]
export LANGFUSE_PRICE_STT_FLUX_PER_MS=0.00000010833
# Nova-3 streaming, $0.0077/min ÷ 60000                             [published]
# NOTE: your live Langfuse currently has BOTH flux and nova at Nova's rate.
# If that was a copy rather than your contract, this line is the fix.
export LANGFUSE_PRICE_STT_NOVA_PER_MS=0.00000012833

# ── Cartesia TTS — $ per character ───────────────────────────────────────────
# $22 per 1M characters — matches the entry already live on your instance.
# Cartesia's public range is $5–37/M depending on plan, so confirm your tier.
export LANGFUSE_PRICE_TTS_SONIC_PER_CHARACTER=0.000022

# ── Gemini — $ per token. One set per model; they differ by ~10x. ────────────

# gemini-2.5-flash — cascade default, and the post-call eval
# $0.30/M in, $2.50/M out, $0.03/M cached                            [langfuse]
export LANGFUSE_PRICE_LLM_GEMINI_2_5_FLASH_INPUT_PER_TOKEN=0.0000003
export LANGFUSE_PRICE_LLM_GEMINI_2_5_FLASH_OUTPUT_PER_TOKEN=0.0000025
export LANGFUSE_PRICE_LLM_GEMINI_2_5_FLASH_CACHED_PER_TOKEN=0.00000003

# gemini-3.1-flash-lite — call summary, health observer
# $0.25/M in, $1.50/M out, $0.025/M cached                           [langfuse]
# (Langfuse lists these under `gemini-3.1-flash-lite-preview`.)
export LANGFUSE_PRICE_LLM_GEMINI_3_1_FLASH_LITE_INPUT_PER_TOKEN=0.00000025
export LANGFUSE_PRICE_LLM_GEMINI_3_1_FLASH_LITE_OUTPUT_PER_TOKEN=0.0000015
export LANGFUSE_PRICE_LLM_GEMINI_3_1_FLASH_LITE_CACHED_PER_TOKEN=0.000000025

# gemini-3.5-flash — Observer answer extraction
# $1.50/M in, $9.00/M out                                           [published]
# Cached at 10% of input — Google documents "up to 90% off" on cached
# context but publishes no flat figure for this model.               [inferred]
export LANGFUSE_PRICE_LLM_GEMINI_3_5_FLASH_INPUT_PER_TOKEN=0.0000015
export LANGFUSE_PRICE_LLM_GEMINI_3_5_FLASH_OUTPUT_PER_TOKEN=0.000009
export LANGFUSE_PRICE_LLM_GEMINI_3_5_FLASH_CACHED_PER_TOKEN=0.00000015

# gemini-3.6-flash — seen live via a tenant llm_model_override
# INTRODUCTORY pricing, $0.75/M in, $3.75/M out                     [published]
# ⚠ Introductory rates END 2026-12-31. From 2027-01-01 the standard rate is
#   $1.50/M in ($0.0000015) and $7.50/M out ($0.0000075) — roughly DOUBLE.
#   Re-run the seeder in January or every 3.6-flash cost is half what it should be.
export LANGFUSE_PRICE_LLM_GEMINI_3_6_FLASH_INPUT_PER_TOKEN=0.00000075
export LANGFUSE_PRICE_LLM_GEMINI_3_6_FLASH_OUTPUT_PER_TOKEN=0.00000375
# Cached at 10% of the introductory input rate.                      [inferred]
# Google publishes $0.15/M cached against the STANDARD $1.50/M input; this line
# keeps the same 10% ratio against the introductory rate instead.
export LANGFUSE_PRICE_LLM_GEMINI_3_6_FLASH_CACHED_PER_TOKEN=0.000000075
